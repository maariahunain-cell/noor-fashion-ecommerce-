import {Link} from 'react-router-dom'
import {useEffect,useRef,useState} from 'react'
import ProductCard from '../components/ProductCard'
import {featuredProducts} from '../data/products'
export default function Home(){
 const [customers,setCustomers]=useState(0); const statRef=useRef(null)
 useEffect(()=>{const el=statRef.current;if(!el)return;const ob=new IntersectionObserver(([e])=>{if(e.isIntersecting){let n=0;const t=setInterval(()=>{n+=10;if(n>=300){n=300;clearInterval(t)}setCustomers(n)},35);ob.disconnect()}},{threshold:.4});ob.observe(el);return()=>ob.disconnect()},[])
 return <>
 <section className="hero"><div className="hero-campaign"><article className="campaign-card campaign-1"><img src="/media/men-hero.jpg"/><div className="campaign-shade"/><div className="campaign-info"><span>MEN</span><strong>20% OFF</strong><Link to="/products?category=Men">EXPLORE →</Link></div></article><article className="campaign-card campaign-2"><video src="/media/women-hero.mp4" autoPlay muted loop playsInline onMouseEnter={e=>e.currentTarget.play()}/><div className="campaign-shade"/><div className="campaign-info"><span>WOMEN</span><strong>15% OFF</strong><Link to="/products?category=Women">EXPLORE →</Link></div></article><article className="campaign-card campaign-3"><img src="/media/soldout-hero.jpg"/><div className="campaign-shade"/><div className="sold-out">SOLD OUT</div><div className="campaign-info"><span>NOOR EDIT</span><strong>30% OFF</strong></div></article></div><div className="hero-copy"><p className="eyebrow">THE NOOR COLLECTION</p><h1>Elegance,<br/><em>Reimagined.</em></h1><p className="hero-description">A refined collection for those who let their presence speak first.</p><div className="hero-actions"><Link to="/products" className="primary-button">Explore Collection</Link><Link to="/signup" className="secondary-button">Join NOOR</Link></div></div></section>
 <section className="intro-section"><p className="eyebrow">DISCOVER NOOR</p><h2>Designed to be noticed.<br/>Made to be remembered.</h2><p>Explore carefully selected pieces across modern menswear and womenswear, created for moments that deserve a little more presence.</p></section>
 
 <section className="category-section"><div className="section-heading centered-heading"><div><p className="eyebrow">EXPLORE</p><h2>Find Your Collection</h2></div></div><div className="category-grid"><Link to="/products?category=Men" className="category-card category-men"><img src="/media/men-hero.jpg"/><div><span>Men</span><small>Explore collection →</small></div></Link><Link to="/products?category=Women" className="category-card category-women"><img src="/media/women-hero.jpg"/><div><span>Women</span><small>Explore collection →</small></div></Link></div></section>
 <section className="product-section curated-mix"><div className="section-heading"><div><p className="eyebrow">CURATED FOR YOU</p><h2>Four Pieces, One Mood</h2></div><Link to="/products" className="text-link">View all →</Link></div><div className="product-grid">{featuredProducts.map(p=><ProductCard key={p.id} product={p} compact/>)}</div></section>
 <section className="brand-story"><div><p className="eyebrow">THE NOOR STORY</p><h2>Fashion with presence.</h2><div className="customer-stat" ref={statRef}><strong>{customers}+</strong><span>HAPPY CUSTOMERS</span></div></div><p>NOOR is imagined as a modern fashion destination where confident silhouettes, refined details and timeless styling meet. From grand evening gowns to statement tailoring, every piece is selected to feel considered, distinctive and unmistakably NOOR.</p></section>
 <section className="contact-section"><div><p className="eyebrow">CONTACT NOOR</p><h2>Let’s stay in touch.</h2></div><div className="contact-details"><p><span>Email</span>noor.bangaluru@gmail.com</p><p><span>Phone</span>8792144481</p></div></section>
 </>
}
