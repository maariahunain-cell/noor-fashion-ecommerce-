import {useState} from 'react';import {Link,useNavigate} from 'react-router-dom';import {useStore} from '../context/StoreContext';import {products} from '../data/products'
export default function Checkout(){const {user,cart}=useStore();const nav=useNavigate();const [done,setDone]=useState(false);const [form,setForm]=useState({address:'',city:'',pincode:''});if(!user)return <section className="auth-page"><div className="auth-panel centered-auth"><p className="eyebrow">CHECKOUT</p><h1>Login required.</h1><p>Please log in or create your NOOR account to continue to checkout.</p><div className="modal-actions"><Link className="primary-button" to="/login?returnTo=/checkout">Log In</Link><Link className="secondary-button" to="/signup?returnTo=/checkout">Sign Up</Link></div></div></section>;const total=cart.reduce((s,i)=>s+(products.find(p=>p.id===i.id)?.price||0)*i.qty,0);if(done)return <section className="auth-page"><div className="auth-panel centered-auth"><p className="eyebrow">ORDER CONFIRMED</p><h1>Thank you, {user.name}.</h1><p>Your NOOR order has been placed. Estimated delivery is within 5–7 days.</p><Link className="primary-button" to="/products">Continue Shopping</Link></div></section>;return <section className="checkout-page"><div><p className="eyebrow">CHECKOUT</p><h1>Complete your order.</h1><form className="checkout-form" onSubmit={e=>{e.preventDefault();setDone(true)}}><label>Delivery Address<textarea required value={form.address} onChange={e=>setForm({...form,address:e.target.value})}/></label><div className="two-fields"><label>City<input required value={form.city} onChange={e=>setForm({...form,city:e.target.value})}/></label><label>PIN Code<input required value={form.pincode} onChange={e=>setForm({...form,pincode:e.target.value})}/></label></div><button className="primary-button">Place Order · ₹ {total.toLocaleString('en-IN')}</button></form></div><aside className="cart-summary"><p>ORDER SUMMARY</p><h2>₹ {total.toLocaleString('en-IN')}</h2><small>{cart.length} line item(s) in your bag.</small></aside></section>}
