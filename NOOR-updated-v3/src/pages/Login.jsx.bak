import {useState} from 'react';import {Link,useLocation,useNavigate} from 'react-router-dom';import Logo from '../components/Logo';import {useStore} from '../context/StoreContext'
export default function Login(){const [username,setUsername]=useState('');const [password,setPassword]=useState('');const [forgot,setForgot]=useState(false);const {login}=useStore();const nav=useNavigate();const loc=useLocation();const returnTo=new URLSearchParams(loc.search).get('returnTo')||'/products';const submit=e=>{e.preventDefault();login({username,name:username.split('@')[0]});nav(returnTo)};return <section className="auth-screen"><div className="auth-brand"><Logo/></div><div className="auth-panel"><p className="eyebrow">WELCOME BACK</p><h1>Enter NOOR.</h1><p>Sign in to continue your journey through the collection.</p><form onSubmit={submit}><label>Username / Email<input required value={username} onChange={e=>setUsername(e.target.value)} autoComplete="username"/></label><label>Password<input required type="password" value={password} onChange={e=>setPassword(e.target.value)} autoComplete="current-password"/></label><button className="forgot-link" type="button" onClick={()=>setForgot(true)}>Forgot my password?</button><button className="primary-button">LOGIN</button></form><p className="auth-switch">Don’t have an account? <Link to={`/signup${returnTo!=='/products'?`?returnTo=${encodeURIComponent(returnTo)}`:''}`}>Sign Up</Link></p></div>{forgot&&<div className="modal-backdrop"><div className="auth-modal"><button className="modal-close" onClick={()=>setForgot(false)}>×</button><p className="eyebrow">PASSWORD RESET</p><h2>We’ve received it.</h2><p>Your new password will be generated in <strong>4 hours</strong>. Please check your registered email for further instructions.</p><button className="primary-button" onClick={()=>setForgot(false)}>BACK TO LOGIN</button></div></div>}</section>}
